--==================================================
-- BRAINROTS
--==================================================

local brainrots = {}

local function createBrainrot(name, value, position)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = Vector3.new(4, 4, 4)
	part.Anchored = true
	part.CanCollide = true
	part.Position = position
	part.Color = Color3.fromHSV(math.random(), 0.8, 1)
	part.Parent = world

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 180, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = name .. "\n$" .. value
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.TextScaled = true
	label.Parent = billboard

	local data = {
		part = part,
		name = name,
		value = value,
		stolen = false
	}

	table.insert(brainrots, data)

	return data
end

createBrainrot("Common Brainrot", 10, Vector3.new(20, 2, 20))
createBrainrot("Rare Brainrot", 25, Vector3.new(-20, 2, 20))
createBrainrot("Epic Brainrot", 75, Vector3.new(20, 2, -20))
