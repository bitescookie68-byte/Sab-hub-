--==================================================
-- MONEY
--==================================================

local function addMoney(amount)
	money += math.floor(amount * incomeMultiplier)
	moneyLabel.Text = "Money: $" .. money
end

--==================================================
-- STEAL
--==================================================

local function stealBrainrot(brainrot)
	if not brainrot or brainrot.stolen then
		return
	end

	brainrot.stolen = true
	brainrot.part.Position = base.Position + Vector3.new(
		math.random(-9, 9),
		3,
		math.random(-9, 9)
	)

	brainrot.part.Color = Color3.fromRGB(80, 255, 120)
end

--==================================================
-- MOVE TO BASE
--==================================================

local function moveToBase()
	local character = player.Character
	if not character then
		return
	end

	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		root.CFrame = base.CFrame + Vector3.new(0, 5, 0)
	end
end

--==================================================
-- AUTO COLLECT
--==================================================

local function collectAll()
	for _, brainrot in ipairs(brainrots) do
		if brainrot.stolen then
			addMoney(brainrot.value)
			brainrot.stolen = false

			brainrot.part.Position = Vector3.new(
				math.random(-25, 25),
				2,
				math.random(-25, 25)
			)

			brainrot.part.Color = Color3.fromHSV(math.random(), 0.8, 1)
		end
	end
end

